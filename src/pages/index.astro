---
import Base from '../layouts/Base.astro';
import { FloatingOrb } from '../components/ui/floating-orb';
import { DesktopPreview } from '../components/ui/desktop-preview';
---

<Base title="Voice Mirror — The Voice-Native IDE. Build apps by voice; your AI sees and drives them.">

  <!-- Floating orb tour guide -->
  <FloatingOrb client:load />

  <!-- Hero Section — Voice Mirror lead -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 pt-20 pb-24 md:pt-28 md:pb-32">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <!-- Left: Headline -->
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-surface-400 mb-8">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-500"></span>
            </span>
            Alpha — Windows-first, open for early adopters
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] text-white">
            Build apps by voice.
            <span class="decoration-accent-500 underline decoration-2 underline-offset-4">Your AI sees them run.</span>
          </h1>
        </div>

        <!-- Right: Description -->
        <div class="md:pt-20">
          <p class="text-lg md:text-xl text-surface-400 leading-relaxed">
            Voice Mirror is a <strong class="text-surface-200">voice-native IDE</strong>. Describe what you want,
            watch it render live in the App Preview, and the in-app AI <strong class="text-surface-200">sees and drives</strong>
            the running app — web, desktop, or native Windows apps — on the same screen you're watching.
            Talk, build, see, fix.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-start gap-4">
            <a href="/docs/introduction/" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3 text-base font-medium text-surface-300 hover:bg-white/5 transition-all">
              Get Started
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href="https://discord.com/invite/JBpsSFB7EQ" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3 text-base font-medium text-surface-300 hover:bg-white/5 transition-all">
              Join the Discord
            </a>
            <a href="https://github.com/contextmirror/voice-mirror" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3 text-base font-medium text-surface-300 hover:bg-white/5 transition-all">
              View on GitHub
            </a>
          </div>
        </div>
      </div>

      <!-- Desktop preview with OS switcher -->
      <div class="mt-20 max-w-5xl mx-auto">
        <DesktopPreview client:load />
      </div>
    </div>
  </section>

  <!-- What It Does — key capabilities -->
  <section class="border-y border-white/5 bg-surface-900/30">
    <div class="mx-auto max-w-7xl px-6 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-3xl font-bold text-white">75+</div>
          <div class="mt-1 text-sm text-surface-500">AI Models via OpenCode</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white">45</div>
          <div class="mt-1 text-sm text-surface-500">MCP Tools</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white">6,700+</div>
          <div class="mt-1 text-sm text-surface-500">Tests Passing</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-white">100%</div>
          <div class="mt-1 text-sm text-surface-500">Local Voice</div>
        </div>
      </div>
    </div>
  </section>

  <!-- App Preview — the headline capability: see and drive -->
  <section id="app-preview" class="py-24 md:py-32 border-b border-white/5">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: the pitch -->
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-accent-500/30 bg-accent-500/10 px-4 py-1.5 text-sm text-accent-400 mb-6">
            New — App Preview
          </div>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">
            Your AI sees and drives what you build
          </h2>
          <p class="mt-5 text-lg text-surface-400 leading-relaxed">
            Ask Voice Mirror to build an app and it renders live in the <strong class="text-surface-200">App Preview</strong> —
            a true-size, running view of your app. You and the AI look at the exact same surface. Then the AI
            doesn't just look: it <strong class="text-surface-200">clicks, types, and reads</strong> the running
            app to check its own work and fix what's broken.
          </p>

          <div class="mt-8 space-y-5">
            <div class="flex gap-4">
              <div class="mt-1 shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 text-accent-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">Web &amp; desktop apps, via CDP</h3>
                <p class="text-sm text-surface-400 leading-relaxed">Web, Tauri, WebView2, and Electron apps stream live and are driven through the Chrome DevTools Protocol.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="mt-1 shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 text-accent-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">Native Windows apps, via UI Automation</h3>
                <p class="text-sm text-surface-400 leading-relaxed">Notepad, Calculator, Settings, Win32/WPF/Qt — driven with the very same tools. The AI can't tell which engine is underneath.</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="mt-1 shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-lg bg-white/5 text-accent-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              </div>
              <div>
                <h3 class="font-semibold text-white">Same surface, two-way focus</h3>
                <p class="text-sm text-surface-400 leading-relaxed">The preview follows whichever window you or the AI last touched, so you're always watching the same thing.</p>
              </div>
            </div>
          </div>

          <p class="mt-8 text-sm text-surface-500">
            The see-and-drive loop is <strong class="text-surface-400">Windows-only</strong> during alpha. macOS and Linux are on the way.
          </p>
        </div>

        <!-- Right: placeholder visual (swap in a real App Preview screenshot/video) -->
        <div class="relative">
          <div class="rounded-2xl border border-white/10 bg-surface-900/40 shadow-2xl overflow-hidden aspect-[4/3]">
            <!-- App Preview window chrome -->
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/5 bg-surface-900/60">
              <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
              <span class="ml-3 text-xs text-surface-500">App Preview — your app, running live</span>
            </div>
            <div class="relative flex h-full items-center justify-center p-8">
              <!-- placeholder content -->
              <div class="text-center">
                <div class="mx-auto mb-4 inline-flex items-center justify-center w-16 h-16 rounded-2xl border border-white/10 bg-white/5">
                  <svg class="w-8 h-8 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                </div>
                <p class="text-surface-400 text-sm">Live App Preview screenshot goes here</p>
                <p class="text-surface-600 text-xs mt-1">AI driving the running app — click, type, verify</p>
              </div>
              <!-- faux @ref highlight to hint at the element tree -->
              <div class="absolute left-10 bottom-10 rounded-md border border-accent-500/50 bg-accent-500/10 px-2 py-1 text-[10px] font-mono text-accent-400">@e7 · button "Save"</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section — Voice Mirror focused -->
  <section id="features" class="py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl mb-16">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">
          Everything you'd want from an AI assistant
        </h2>
        <p class="mt-4 text-lg text-surface-400">
          Voice Mirror sits as a floating orb on your desktop and expands into a full voice-native IDE — code editor, file tree, integrated terminal, live App Preview, and an AI that sees, hears, and builds alongside you.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Voice-First Control</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            Say "Hey Claude" and start talking. Wake word activation, push-to-talk, or continuous conversation mode. Your hands stay on the keyboard.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Screen Awareness</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            "What's this error on my screen?" — Voice Mirror captures your display and understands what you're looking at. Vision-powered analysis of anything visible.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Terminal Power</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            Spawns Claude Code internally for real command execution. Run tests, fix bugs, deploy — all through natural conversation. No copy-pasting.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Browser Automation</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            Full Chrome control via CDP. Navigate, click, fill forms, take screenshots. "Search for flights to Paris" — it opens the browser and does it.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Persistent Memory</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            Three-tier memory system that remembers your preferences, past conversations, and project context across sessions. It knows you.
          </p>
        </div>

        <!-- Feature 6: App Preview (see & drive) -->
        <a href="#app-preview" class="glow-hover group rounded-2xl border border-accent-500/20 bg-accent-500/[0.04] p-8 hover:bg-accent-500/[0.07] transition-all block">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-accent-500/15 text-accent-400 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">App Preview — See &amp; Drive</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            Build an app by voice and watch it render live. The AI sees the same running app you do — then clicks, types, and reads it to verify and fix its own work. Web, desktop, and native Windows apps.
          </p>
        </a>

        <!-- Feature 7: Built-in IDE -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Built-in IDE</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            A full VS Code-style workspace — CodeMirror editor, file tree, command palette, language-server smarts, integrated terminals, and a dev-server manager. Edit, run, and preview, all voice-assisted.
          </p>
        </div>

        <!-- Feature 8 -->
        <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-white/5 text-surface-300 mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
          </div>
          <h3 class="text-xl font-semibold text-white">Fully Customizable</h3>
          <p class="mt-3 text-surface-400 leading-relaxed">
            A full theme suite — built-in presets (including a colorblind-safe default and a light mode), customizable colors, orb styling, custom fonts, and JSON theme import/export. Make it yours.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-24 border-t border-white/5 bg-surface-900/20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl mb-16">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">
          How it works
        </h2>
        <p class="mt-4 text-lg text-surface-400">
          A tiny floating orb that expands into a full AI command center.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl">
        <div class="glow-hover rounded-2xl border border-white/5 bg-surface-900/30 p-8">
          <div class="text-5xl font-bold text-accent-500 mb-4">01</div>
          <h3 class="text-lg font-semibold text-white">Launch & Float</h3>
          <p class="mt-2 text-surface-400 text-sm leading-relaxed">Start Voice Mirror and a small orb appears on your desktop. It's always there — activate it with a wake word, push-to-talk, or continuous call mode. Drag it anywhere you like.</p>
        </div>
        <div class="glow-hover rounded-2xl border border-white/5 bg-surface-900/30 p-8">
          <div class="text-5xl font-bold text-accent-500 mb-4">02</div>
          <h3 class="text-lg font-semibold text-white">Describe &amp; Build</h3>
          <p class="mt-2 text-surface-400 text-sm leading-relaxed">Say what you want to build. The AI writes the code, runs the dev server, and launches your app live in the App Preview. Works with Claude Code, OpenCode, Ollama, and more.</p>
        </div>
        <div class="glow-hover rounded-2xl border border-white/5 bg-surface-900/30 p-8">
          <div class="text-5xl font-bold text-accent-500 mb-4">03</div>
          <h3 class="text-lg font-semibold text-white">See, Drive &amp; Fix</h3>
          <p class="mt-2 text-surface-400 text-sm leading-relaxed">You both watch the running app on the same screen. The AI clicks and types through it, catches what's broken, fixes the code, and speaks the results back. You stay focused on what matters.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AI Providers -->
  <section data-orb-trigger="providers" class="py-24 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">
            Your choice of AI
          </h2>
          <p class="mt-4 text-lg text-surface-400 leading-relaxed">
            Switch between AI providers without restart. Use Claude Code for agentic coding, OpenCode to unlock 75+ models, or Ollama for local privacy. Mix and match to suit your workflow.
          </p>
          <div class="mt-8 grid grid-cols-2 gap-4">
            <div class="flex items-center gap-3 text-surface-300">
              <svg class="w-5 h-5 text-accent-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Claude Code
            </div>
            <div class="flex items-center gap-3 text-surface-300">
              <svg class="w-5 h-5 text-accent-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              OpenCode (75+ models)
            </div>
            <div class="flex items-center gap-3 text-surface-300">
              <svg class="w-5 h-5 text-accent-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Ollama (local)
            </div>
            <div class="flex items-center gap-3 text-surface-300">
              <svg class="w-5 h-5 text-accent-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              OpenAI / GPT-4o
            </div>
            <div class="flex items-center gap-3 text-surface-300">
              <svg class="w-5 h-5 text-accent-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Gemini / Grok
            </div>
            <div class="flex items-center gap-3 text-surface-300">
              <svg class="w-5 h-5 text-accent-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              DeepSeek + more
            </div>
          </div>
        </div>

        <!-- AI Provider settings screenshot -->
        <div>
          <div class="rounded-2xl border border-white/10 shadow-2xl overflow-hidden">
