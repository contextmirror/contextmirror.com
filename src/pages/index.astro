---
import Base from '../layouts/Base.astro';

const providers = [
  'Claude Code', 'OpenCode', 'Codex', 'Gemini CLI', 'Kimi CLI',
  'Ollama', 'LM Studio', 'Jan', 'OpenAI', 'Groq', 'Mistral', 'DeepSeek', 'OpenRouter', 'Grok',
];
---

<Base title="Voice Mirror — The Voice-Native IDE. Build apps by voice; your AI sees and drives them.">

  <!-- ───────────────────────── HERO ───────────────────────── -->
  <section class="relative overflow-hidden blueprint-grid">
    <div class="absolute inset-0 ink-spot pointer-events-none"></div>
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-500/40 to-transparent"></div>

    <div class="relative mx-auto max-w-7xl px-6 pt-20 pb-24 md:pt-28 md:pb-28">
      <div class="grid lg:grid-cols-[1.05fr_1fr] gap-14 lg:gap-12 items-center">

        <!-- Left: thesis -->
        <div class="reveal" style="animation-delay:0ms">
          <div class="font-mono text-xs tracking-widest text-accent-400 uppercase mb-6">
            // the voice-native IDE
          </div>

          <h1 class="font-display font-bold tracking-tight text-white text-5xl md:text-6xl lg:text-[4.2rem] leading-[0.98]">
            Build it by voice.<br />
            Watch your AI
            <span class="relative whitespace-nowrap text-accent-400">
              drive it
              <svg class="absolute -bottom-2 left-0 w-full" height="8" viewBox="0 0 200 8" fill="none" preserveAspectRatio="none"><path d="M1 5.5C40 2 160 2 199 5.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
            </span>.
          </h1>

          <p class="mt-8 text-lg text-surface-300 leading-relaxed max-w-xl">
            Voice Mirror is a voice-native IDE. Describe what you want, watch it render
            live in the App Preview, and the in-app AI <span class="text-white font-medium">sees and drives</span>
            the running app — clicking, typing, and reading it to fix its own work.
          </p>

          <!-- voice transcript line (the human side, in amber) -->
          <div class="mt-8 inline-flex items-center gap-3 rounded-xl border border-voice-400/25 bg-voice-400/[0.06] px-4 py-2.5 font-mono text-sm">
            <span class="live-dot h-2 w-2 rounded-full bg-voice-400 shrink-0"></span>
            <span class="text-voice-300">"build me a login screen"</span>
            <span class="vm-caret"></span>
          </div>

          <div class="mt-9 flex flex-wrap items-center gap-3">
            <a href="https://github.com/contextmirror/voice-mirror/releases/latest/download/voice-mirror-x64-setup.exe" class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-6 py-3 text-sm font-semibold text-white hover:bg-accent-400 transition-colors shadow-[0_0_30px_-6px] shadow-accent-500/60">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
              Download for Windows
            </a>
            <a href="/docs/quickstart/" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/12 px-6 py-3 text-sm font-medium text-surface-200 hover:bg-white/5 transition-all">
              Get started
            </a>
            <a href="https://discord.com/invite/JBpsSFB7EQ" class="inline-flex items-center gap-2 rounded-full px-4 py-3 text-sm font-medium text-surface-400 hover:text-white transition-colors">
              Discord
            </a>
            <a href="https://github.com/contextmirror/voice-mirror" class="inline-flex items-center gap-2 rounded-full px-4 py-3 text-sm font-medium text-surface-400 hover:text-white transition-colors">
              GitHub
            </a>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs text-surface-500">
            <span class="text-accent-400/90">● alpha</span>
            <span>Windows-first</span>
            <span>Free &amp; open source</span>
            <span>Tauri 2 · Rust · Svelte 5</span>
          </div>
          <p class="mt-3 font-mono text-[11px] text-surface-600">
            unsigned alpha build — SmartScreen: “More info” → “Run anyway” ·
            <a href="https://github.com/contextmirror/voice-mirror/releases" class="hover:text-surface-400 underline underline-offset-2">all releases</a>
          </p>
        </div>

        <!-- Right: the signature — the promo video -->
        <div class="reveal" style="animation-delay:140ms">
          <div class="relative rounded-2xl border border-white/10 bg-ink-850/80 backdrop-blur shadow-2xl shadow-black/60 overflow-hidden">
            <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-500/40 to-transparent z-10"></div>
            <video
              class="block w-full aspect-video"
              src="/videos/voice-mirror-promo.mp4"
              poster="/videos/voice-mirror-promo-poster.jpg"
              autoplay
              muted
              loop
              playsinline
              controls
              preload="metadata"
            >
              Your browser doesn't support embedded video —
              <a href="/videos/voice-mirror-promo.mp4">download the promo</a> instead.
            </video>
          </div>

          <p class="mt-3 text-center font-mono text-[11px] text-surface-600">
            one minute — the whole loop, unmute for sound
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── THE REAL APP (screenshot) ───────────── -->
  <section class="border-t border-white/5 bg-ink-900">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
      <div class="max-w-2xl mx-auto text-center mb-10">
        <div class="font-mono text-xs tracking-widest text-accent-400 uppercase mb-4">// the actual app</div>
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-white">This is Voice Mirror</h2>
        <p class="mt-4 text-lg text-surface-300 leading-relaxed">
          A full IDE, a live App Preview, and a voice-driven AI agent — in one native Rust window.
        </p>
      </div>
      <div class="relative mx-auto max-w-6xl rounded-2xl border border-white/10 bg-ink-850/60 overflow-hidden shadow-2xl shadow-black/60">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent-500/40 to-transparent"></div>
        <img
          src="/screenshots/voice-mirror-app.png"
          alt="Voice Mirror — the voice-native IDE: file tree, live App Preview, chat, and terminal in one window"
          class="block w-full"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ───────────────── THE LOOP (real sequence) ───────────────── -->
  <section class="border-y border-white/5 bg-ink-900">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
      <div class="flex items-baseline justify-between flex-wrap gap-4 mb-12">
        <h2 class="font-display text-2xl md:text-3xl font-bold text-white tracking-tight">The loop</h2>
        <p class="font-mono text-xs text-surface-500">voice&nbsp;→&nbsp;build&nbsp;→&nbsp;see&nbsp;→&nbsp;fix</p>
      </div>

      <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-white/5 rounded-2xl overflow-hidden border border-white/5">
        <li class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-voice-400 mb-4">01 / voice</div>
          <h3 class="text-white font-semibold">Say what you want</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">Wake word, push-to-talk, or call mode. Describe the app or the change in plain words.</p>
        </li>
        <li class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-accent-400 mb-4">02 / build</div>
          <h3 class="text-white font-semibold">It writes &amp; runs it</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">The AI edits the code, starts the dev server, and launches your app live in the App Preview.</p>
        </li>
        <li class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-accent-400 mb-4">03 / see</div>
          <h3 class="text-white font-semibold">You both watch it run</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">One live surface, true to size. The AI reads the same running app you're looking at.</p>
        </li>
        <li class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-accent-400 mb-4">04 / fix</div>
          <h3 class="text-white font-semibold">It drives &amp; repairs</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">It clicks and types through the app, catches what's broken, and fixes the code — then speaks back.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ───────────── SEE & DRIVE: one surface, two engines ───────────── -->
  <section id="features" class="relative blueprint-grid">
    <div class="mx-auto max-w-7xl px-6 py-24 md:py-32">
      <div class="max-w-2xl">
        <div class="font-mono text-xs tracking-widest text-accent-400 uppercase mb-4">// see &amp; drive</div>
        <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white">
          One surface. Two engines.
        </h2>
        <p class="mt-5 text-lg text-surface-300 leading-relaxed">
          Voice Mirror exposes every running app as the same accessibility tree of
          <span class="font-mono text-accent-300">@ref</span> handles. The AI clicks and types by ref —
          and never has to know whether it's driving a web app or a native window.
        </p>
      </div>

      <div class="mt-14 grid lg:grid-cols-2 gap-6">
        <!-- CDP engine -->
        <div class="rounded-2xl border border-white/8 bg-ink-850/70 p-7">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-white font-semibold">Web, Tauri &amp; Electron</h3>
            <span class="ref-chip">CDP</span>
          </div>
          <div class="rounded-xl border border-white/8 bg-ink-950/70 p-4 font-mono text-xs leading-relaxed text-surface-400 space-y-1.5">
            <div><span class="text-surface-600">▾</span> document <span class="text-accent-300/80">@e1</span></div>
            <div class="pl-4"><span class="text-surface-600">▾</span> form "login" <span class="text-accent-300/80">@e3</span></div>
            <div class="pl-8">textbox "Email" <span class="text-accent-300/80">@e4</span></div>
            <div class="pl-8">textbox "Password" <span class="text-accent-300/80">@e5</span></div>
            <div class="pl-8 text-surface-200">button "Sign in" <span class="text-accent-300">@e7</span></div>
          </div>
          <p class="mt-4 text-sm text-surface-400 leading-relaxed">Streamed live over the Chrome DevTools Protocol — the same channel that drives Voice Mirror's browser automation.</p>
        </div>

        <!-- UIA engine -->
        <div class="rounded-2xl border border-white/8 bg-ink-850/70 p-7">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-white font-semibold">Native Windows apps</h3>
            <span class="ref-chip">UI Automation</span>
          </div>
          <div class="rounded-xl border border-white/8 bg-ink-950/70 p-4 font-mono text-xs leading-relaxed text-surface-400 space-y-1.5">
            <div><span class="text-surface-600">▾</span> window "Calculator" <span class="text-accent-300/80">@e1</span></div>
            <div class="pl-4"><span class="text-surface-600">▾</span> group "Standard" <span class="text-accent-300/80">@e2</span></div>
            <div class="pl-8">button "Seven" <span class="text-accent-300/80">@e4</span></div>
            <div class="pl-8">button "Plus" <span class="text-accent-300/80">@e5</span></div>
            <div class="pl-8 text-surface-200">button "Equals" <span class="text-accent-300">@e9</span></div>
          </div>
          <p class="mt-4 text-sm text-surface-400 leading-relaxed">Notepad, Calculator, Settings, Win32/WPF/Qt — driven through UI Automation with the very same tools and refs.</p>
        </div>
      </div>

      <p class="mt-6 font-mono text-sm text-surface-500">
        <span class="text-accent-400">$</span> same tools · same @refs · the AI can't tell which engine is underneath
        <span class="text-surface-700">— Windows-first during alpha</span>
      </p>
    </div>
  </section>

  <!-- ───────────────── CAPABILITIES ───────────────── -->
  <section class="border-t border-white/5 bg-ink-900">
    <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
      <div class="max-w-2xl mb-14">
        <div class="font-mono text-xs tracking-widest text-accent-400 uppercase mb-4">// everything wired together</div>
        <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white">
          A full agent, not a chat box
        </h2>
        <p class="mt-5 text-lg text-surface-300 leading-relaxed">
          The see-and-drive loop rides on a complete desktop agent: it hears you, sees your screen,
          runs your terminal, and remembers across sessions.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5 rounded-2xl overflow-hidden border border-white/5">
        <div class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-surface-500 mb-3">voice</div>
          <h3 class="text-white font-semibold">Voice control</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">Wake word ("Hey Claude"), push-to-talk, or always-on call mode. Local Whisper in, local Kokoro out — Edge voices when you're online.</p>
        </div>
        <div class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-surface-500 mb-3">build</div>
          <h3 class="text-white font-semibold">Built-in IDE</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">CodeMirror editor, file tree, command palette, language-server smarts, integrated terminals, and a dev-server manager.</p>
        </div>
        <div class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-surface-500 mb-3">see</div>
          <h3 class="text-white font-semibold">Screen awareness</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">"What's this error on my screen?" — it captures your display and reasons about whatever you're looking at.</p>
        </div>
        <div class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-surface-500 mb-3">act</div>
          <h3 class="text-white font-semibold">Browser automation</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">Real CDP control — navigate, click, fill, screenshot, read the DOM. Not "search and summarize."</p>
        </div>
        <div class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-surface-500 mb-3">remember</div>
          <h3 class="text-white font-semibold">Persistent memory</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">A three-tier memory with hybrid semantic + keyword search. Preferences and project context carry across sessions.</p>
        </div>
        <div class="bg-ink-900 p-7">
          <div class="font-mono text-xs text-surface-500 mb-3">extend</div>
          <h3 class="text-white font-semibold">45 MCP tools</h3>
          <p class="mt-2 text-sm text-surface-400 leading-relaxed">Five groups — core, capture, memory, browser, n8n — loaded on demand for any MCP-aware agent.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────── PROVIDERS ───────────────── -->
  <section class="relative blueprint-grid border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
      <div class="grid lg:grid-cols-[1fr_1.2fr] gap-14 items-center">
        <div>
          <div class="font-mono text-xs tracking-widest text-accent-400 uppercase mb-4">// bring your own brain</div>
          <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white">
            Any model. Switch without restart.
          </h2>
          <p class="mt-5 text-lg text-surface-300 leading-relaxed">
            Run Claude Code for agentic coding, OpenCode to unlock
            <span class="text-white font-medium">75+ models</span>, or a local LLM for full privacy.
            CLI agents and cloud APIs, all behind one interface.
          </p>
          <div class="mt-6 flex gap-6 font-mono text-sm">
            <div><span class="text-accent-400 text-2xl font-display font-bold">5</span><span class="text-surface-500 ml-2">CLI agents</span></div>
            <div><span class="text-accent-400 text-2xl font-display font-bold">3</span><span class="text-surface-500 ml-2">local runtimes</span></div>
            <div><span class="text-accent-400 text-2xl font-display font-bold">7</span><span class="text-surface-500 ml-2">cloud APIs</span></div>
          </div>
        </div>

        <div class="flex flex-wrap gap-2.5">
          {providers.map((p) => (
            <span class="rounded-lg border border-white/8 bg-ink-850/60 px-3.5 py-2 text-sm text-surface-300 font-mono">{p}</span>
          ))}
          <span class="rounded-lg border border-accent-500/30 bg-accent-500/10 px-3.5 py-2 text-sm text-accent-300 font-mono">+ more</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────── LOCAL / LIGHTWEIGHT ───────────────── -->
  <section class="border-t border-white/5 bg-ink-900">
    <div class="mx-auto max-w-7xl px-6 py-24 md:py-28">
      <div class="max-w-2xl mb-12">
        <div class="font-mono text-xs tracking-widest text-accent-400 uppercase mb-4">// native by design</div>
        <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white">
          Rust under the hood. CPU or GPU.
        </h2>
        <p class="mt-5 text-lg text-surface-300 leading-relaxed">
          The whole backend — windowing, voice pipeline, MCP server — is native Rust on Tauri 2.
          No Electron, no Node runtime, no Python. The voice stack runs on CPU and works fully
          offline — and taps your GPU when it's there to make dictation and speech instant.
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/5 rounded-2xl overflow-hidden border border-white/5">
        <div class="bg-ink-900 p-7 text-center">
          <div class="font-display text-3xl font-bold text-accent-400">Rust</div>
          <div class="mt-1 text-sm text-surface-500">Native backend</div>
        </div>
        <div class="bg-ink-900 p-7 text-center">
          <div class="font-display text-3xl font-bold text-accent-400">0</div>
          <div class="mt-1 text-sm text-surface-500">Electron · Node · Python</div>
        </div>
        <div class="bg-ink-900 p-7 text-center">
          <div class="font-display text-3xl font-bold text-accent-400">GPU</div>
          <div class="mt-1 text-sm text-surface-500">Optional acceleration</div>
        </div>
        <div class="bg-ink-900 p-7 text-center">
          <div class="font-display text-3xl font-bold text-accent-400">Offline</div>
          <div class="mt-1 text-sm text-surface-500">Runs fully local</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────── CTA ───────────────── -->
  <section class="relative overflow-hidden border-t border-white/5 blueprint-grid">
    <div class="absolute inset-0 ink-spot pointer-events-none"></div>
    <div class="relative mx-auto max-w-7xl px-6 py-28 text-center">
      <h2 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white">
        Ready to build by voice?
      </h2>
      <p class="mt-5 text-lg text-surface-300 max-w-xl mx-auto leading-relaxed">
        Voice Mirror is free and open source, in active alpha on Windows.
        Grab the installer, or join the Discord and build along.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="https://github.com/contextmirror/voice-mirror/releases/latest/download/voice-mirror-x64-setup.exe" class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-7 py-3.5 text-sm font-semibold text-white hover:bg-accent-400 transition-colors shadow-[0_0_30px_-6px] shadow-accent-500/60">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
          Download for Windows
        </a>
        <a href="/docs/quickstart/" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/12 px-7 py-3.5 text-sm font-medium text-surface-200 hover:bg-white/5 transition-all">
          Get started
        </a>
        <a href="https://discord.com/invite/JBpsSFB7EQ" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/12 px-7 py-3.5 text-sm font-medium text-surface-200 hover:bg-white/5 transition-all">
          Join the Discord
        </a>
      </div>
      <p class="mt-6 font-mono text-xs text-surface-600">
        unsigned alpha installer — SmartScreen: “More info” → “Run anyway” ·
        <a href="https://github.com/contextmirror/voice-mirror/releases/tag/nightly" class="text-surface-500 hover:text-surface-300 underline underline-offset-2">nightly channel</a>
      </p>
    </div>
  </section>

</Base>
