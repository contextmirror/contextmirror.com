---
import Base from '../layouts/Base.astro';
---

<Base title="Voice Mirror — The Voice-Native IDE" description="Build apps by voice and watch your AI see and drive them in a live App Preview. A voice-native IDE with code editor, terminal, screen awareness, 45 MCP tools, and 75+ AI models via Claude Code, OpenCode, Ollama, and more. Windows-first, free and open source.">

  <!-- Hero -->
  <section class="relative">
    <div class="mx-auto max-w-7xl px-6 pt-20 pb-24 md:pt-28 md:pb-32">
      <div class="grid md:grid-cols-2 gap-12 items-start">
        <!-- Left: Headline -->
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-surface-400 mb-8">
            Free & Open Source · Windows-first alpha
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.05] text-white">
            Build by voice.
            <span class="bg-gradient-to-r from-accent-400 to-primary-400 bg-clip-text text-transparent">
              Your AI sees it run.
            </span>
          </h1>
        </div>

        <!-- Right: Description -->
        <div class="md:pt-20">
          <p class="text-lg md:text-xl text-surface-400 leading-relaxed">
            A voice-native IDE that pairs an AI coding agent with a live App Preview. Describe what you want, watch it render, and the in-app AI sees and drives the running app — clicking, typing, and reading it to verify its own work. Code editor, terminal, screen awareness, and 75+ AI models, all voice-controlled.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row items-start gap-4">
            <a href="/docs/introduction/" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3 text-base font-medium text-surface-300 hover:bg-white/5 transition-all">
              Get Started
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
            <a href="https://github.com/contextmirror/voice-mirror" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-7 py-3 text-base font-medium text-surface-300 hover:bg-white/5 transition-all">
              View on GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Formula -->
  <section class="border-y border-white/5 bg-surface-900/30">
    <div class="mx-auto max-w-7xl px-6 py-10">
      <div class="grid md:grid-cols-3 gap-6 text-center items-center">
        <div class="glow-hover rounded-2xl border border-white/5 bg-white/[0.02] p-6">
          <div class="text-2xl font-bold text-white">Claude Code</div>
          <div class="mt-1 text-sm text-surface-400">Terminal + MCP Tools</div>
        </div>
        <div class="text-3xl font-bold text-surface-700">+</div>
        <div class="glow-hover rounded-2xl border border-white/5 bg-white/[0.02] p-6">
          <div class="text-2xl font-bold text-accent-500">Voice Mirror</div>
          <div class="mt-1 text-sm text-surface-400">Eyes + Ears + Voice + Hands</div>
        </div>
      </div>
      <div class="text-center mt-6">
        <div class="text-3xl font-bold text-surface-700">=</div>
        <div class="mt-3 text-2xl font-bold text-white">A voice-native IDE where your AI sees and drives what you build</div>
      </div>
    </div>
  </section>

  <!-- Built by Voice -->
  <section class="py-24 border-t border-white/5 bg-surface-900/20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm text-surface-400 mb-6">
          Proof of concept
        </div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">This website was built by voice</h2>
        <p class="mt-4 text-lg text-surface-400">Every page, component, and animation on contextmirror.com was designed and coded entirely through voice commands using Claude Code and Voice Mirror.</p>
      </div>

      <div class="max-w-5xl">
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Voice command examples -->
          <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
            <h3 class="text-lg font-semibold text-white mb-6">How it was built</h3>
            <div class="space-y-4">
              <div class="rounded-lg bg-surface-900/50 p-4">
                <p class="text-surface-300 font-mono text-sm">"Build me a marketing page with a live App Preview hero"</p>
                <p class="text-surface-500 mt-2 text-sm">→ Created the home page with the see-and-drive hero</p>
              </div>
              <div class="rounded-lg bg-surface-900/50 p-4">
                <p class="text-surface-300 font-mono text-sm">"Add a desktop preview that shows Windows, Mac, and Linux"</p>
                <p class="text-surface-500 mt-2 text-sm">→ Built the OS-switchable desktop mockup</p>
              </div>
              <div class="rounded-lg bg-surface-900/50 p-4">
                <p class="text-surface-300 font-mono text-sm">"Navigate to the site and check how it looks"</p>
                <p class="text-surface-500 mt-2 text-sm">→ Used browser tools to screenshot and iterate</p>
              </div>
            </div>
          </div>

          <!-- What this means -->
          <div class="glow-hover group rounded-2xl border border-white/5 bg-white/[0.02] p-8 hover:bg-white/[0.04] transition-all">
            <h3 class="text-lg font-semibold text-white mb-6">What this means</h3>
            <div class="space-y-6 text-surface-400">
              <div>
                <h4 class="font-semibold text-white mb-1">Zero typing required</h4>
                <p class="text-sm leading-relaxed">Every line of code was generated from natural speech. No keyboard, no copy-paste, no manual editing.</p>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Visual feedback loop</h4>
                <p class="text-sm leading-relaxed">Voice Mirror's browser tools let the AI see the website, take screenshots, and iterate on the design in real-time.</p>
              </div>
              <div>
                <h4 class="font-semibold text-white mb-1">Full-stack by voice</h4>
                <p class="text-sm leading-relaxed">Astro pages, React components, Tailwind styling, Framer Motion animations — all created through conversation.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-24 border-t border-white/5">
    <div class="mx-auto max-w-7xl px-6">
      <div class="max-w-3xl mb-16">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">What you can do</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl">
        <div class="glow-hover rounded-2xl border border-white/5 bg-surface-900/30 p-8">
          <h3 class="text-lg font-semibold text-accent-500 mb-4">Developer</h3>
          <div class="space-y-4 text-sm text-surface-400">
            <div class="rounded-lg bg-surface-900/50 p-3 font-mono">
              <p class="text-surface-300">"Build me a sign-up page and launch it"</p>
              <p class="text-surface-500 mt-1">→ writes the code, runs it live in the App Preview</p>
            </div>
            <div class="rounded-lg bg-surface-900/50 p-3 font-mono">
              <p class="text-surface-300">"Click through the form and fix what breaks"</p>
              <p class="text-surface-500 mt-1">→ drives the running app, finds the bug, fixes it</p>
            </div>
          </div>
        </div>
        <div class="glow-hover rounded-2xl border border-white/5 bg-surface-900/30 p-8">
          <h3 class="text-lg font-semibold text-accent-500 mb-4">Desktop</h3>
          <div class="space-y-4 text-sm text-surface-400">
            <div class="rounded-lg bg-surface-900/50 p-3 font-mono">
              <p class="text-surface-300">"What app is using all my memory?"</p>
              <p class="text-surface-500 mt-1">→ checks system, reports via voice</p>
            </div>
            <div class="rounded-lg bg-surface-900/50 p-3 font-mono">
              <p class="text-surface-300">"Search for flights to Paris"</p>
              <p class="text-surface-500 mt-1">→ web search, summarizes results</p>
            </div>
          </div>
        </div>
        <div class="glow-hover rounded-2xl border border-white/5 bg-surface-900/30 p-8">
          <h3 class="text-lg font-semibold text-accent-500 mb-4">Native apps</h3>
          <div class="space-y-4 text-sm text-surface-400">
            <div class="rounded-lg bg-surface-900/50 p-3 font-mono">
              <p class="text-surface-300">"Open Settings and turn on dark mode"</p>
              <p class="text-surface-500 mt-1">→ drives the native Windows app via UI Automation</p>
            </div>
            <div class="rounded-lg bg-surface-900/50 p-3 font-mono">
              <p class="text-surface-300">"Add these figures up in Calculator"</p>
              <p class="text-surface-500 mt-1">→ clicks the buttons itself, reads the result back</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 border-t border-white/5 bg-surface-900/20">
    <div class="mx-auto max-w-7xl px-6 text-center">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white">
        Give your AI a voice
      </h2>
      <p class="mt-4 text-lg text-surface-400 max-w-2xl mx-auto">
        Voice Mirror is free and open source, in active alpha on Windows. Download the installer, or join the Discord and build along.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://github.com/contextmirror/voice-mirror/releases/latest/download/voice-mirror-x64-setup.exe" class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-8 py-3.5 text-base font-semibold text-white hover:bg-accent-400 transition-colors">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/></svg>
          Download for Windows
        </a>
        <a href="/docs/introduction/" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-8 py-3.5 text-base font-semibold text-surface-300 hover:bg-white/5 transition-all">
          Get Started
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="https://discord.com/invite/JBpsSFB7EQ" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-8 py-3.5 text-base font-semibold text-surface-300 hover:bg-white/5 transition-all">
          Join the Discord
        </a>
        <a href="https://github.com/contextmirror/voice-mirror" class="glow-hover inline-flex items-center gap-2 rounded-full border border-white/10 px-8 py-3.5 text-base font-semibold text-surface-300 hover:bg-white/5 transition-all">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

</Base>
